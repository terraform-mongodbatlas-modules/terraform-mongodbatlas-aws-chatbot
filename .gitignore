# path-sync copy -n sdlc
# === DO_NOT_EDIT: path-sync gitignore-base ===
**/.terraform/*
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
*.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.vscode
.venv
.secrets
__pycache__/
*.pyc
# === OK_EDIT: path-sync gitignore-base ===

# === DO_NOT_EDIT: path-sync gitignore-workspace ===
# Workspace test generated files
*.generated.tf
plan.bin
plan.json
plan_snapshots_actual/
outputs_actual.json
dev.tfrc
provider-src/
# === OK_EDIT: path-sync gitignore-workspace ===

# Module render and build artifacts
.render/
.build/

# Chainlit runtime state under the vendored app. Only chatbot/assets/.chainlit/
# config.toml is app content; the app ships chatbot/.gitignore for its own tree,
# and these keep the repo root clean before the app is committed.
/chatbot/.chainlit/
/chatbot/.files/
/chatbot/assets/.chainlit/translations/
/chatbot/assets/.files/
